# Copy to .env for local development (never commit .env)

MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=chutti

SENDGRID_API_KEY=
SENDER_EMAIL=

FRONTEND_URL=http://localhost:3000
# Comma-separated origins for CORS (production: your Vercel frontend URL)
CORS_ORIGINS=http://localhost:3000

# Google Calendar (optional): GCP Calendar API + Workspace domain-wide delegation

HR_CALENDAR_DELEGATE_EMAIL=ipshita@tortoise.pro
# Target calendar — full ID or name (e.g. "OOO Calendar"). Use "primary" for delegate's main calendar.
HR_CALENDAR_ID=c_40f2760b457c7228dbee4e053ab57d32756af19ae6aee15ceb6d6928691813f3@group.calendar.google.com
# Google Group — roster calendar is shared with this group via ACL (not invited per-event).
HR_CALENDAR_GROUP_EMAIL=ooo@tortoise.pro
# Invite each employee individually (required — group-as-attendee does not work via API).
HR_CALENDAR_INVITE_TEAM=true
HR_CALENDAR_SEND_UPDATES=all
