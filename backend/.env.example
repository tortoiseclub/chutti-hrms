# Copy to .env for local development (never commit .env)

MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=chutti

SENDGRID_API_KEY=
SENDER_EMAIL=

FRONTEND_URL=http://localhost:3000
# Comma-separated origins for CORS (production: your Vercel frontend URL)
CORS_ORIGINS=http://localhost:3000

# Google Calendar (optional): use file google_calendar_credentials.json in this folder,
# OR set one of the following for Vercel / serverless:
# GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_CREDENTIALS_JSON_B64=<base64 of the JSON file>
# HR_CALENDAR_DELEGATE_EMAIL=hr@example.com
