# Copy to .env for local development (never commit .env)

MONGO_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=chutti

SENDGRID_API_KEY=
SENDER_EMAIL=

FRONTEND_URL=http://localhost:3000
# Comma-separated origins for CORS (production: your Vercel frontend URL)
CORS_ORIGINS=http://localhost:3000

# Google Calendar (optional): GCP Calendar API + Workspace domain-wide delegation
# (scope https://www.googleapis.com/auth/calendar). See DEPLOY_VERCEL.md section 5.
# Local: google_calendar_credentials.json in this folder, or for Vercel:
# GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_CREDENTIALS_JSON_B64=<base64 of the JSON file>
# Real Workspace USER for API delegation (cannot be a Google Group):
HR_CALENDAR_DELEGATE_EMAIL=ipshita@tortoise.pro
# Target calendar for leave/holiday events (group email for shared OOO calendar):
HR_CALENDAR_ID=ooo@tortoise.pro
